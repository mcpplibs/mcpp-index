// ui/app.slint reaches mcpplibs.mplugin.slint as `options::sources`; the module
// `app.ui` exports what the file exports and slint-compiler generates. The SDK
// is compat.slint, reached through mcpplibs.mwrap.slint.
import mcpp;
import mcpplibs.mplugin.slint;

int main() {
    mcpplibs::mplugin::slint::options o;
    o.sources = {"ui/app.slint"};
    o.module  = "app.ui";
    o.style   = "fluent";
    return mcpplibs::mplugin::slint::compile(o) ? 0 : 1;
}
