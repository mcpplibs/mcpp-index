.xlings-index-cache.json
# example project build/fetch artifacts
tests/examples/*/target/
tests/examples/*/.mcpp/
tests/examples/*/compile_commands.json
tests/examples/*/mcpp.lock
# build.mcpp-generated source (regenerated each build by the build program)
tests/examples/build-mcpp/src/generated.cpp
imgui.ini
tests/examples/*/imgui.ini

# 本地 git worktree(逐包验证时开的),不属于索引内容
.worktrees/

# plugin bytecode
.xpkgindex/plugins/__pycache__/
