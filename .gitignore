.xlings-index-cache.json
# The workspace's build directory, project data, compile database and lock:
# mcpp 2026.9.29.1+ writes them at the workspace root for every member.
/target/
/.mcpp/
/compile_commands.json
/mcpp.lock
# example project build/fetch artifacts
tests/examples/*/target/
tests/examples/*/.mcpp/
tests/examples/*/compile_commands.json
tests/examples/*/mcpp.lock
# build.mcpp-generated source (regenerated each build by the build program)
tests/examples/build-mcpp/src/generated.cpp
imgui.ini
tests/examples/*/imgui.ini

# 本地 git worktree(逐包验证时开的),不属于索引内容
.worktrees/

# plugin bytecode
.xpkgindex/plugins/__pycache__/
__pycache__/
*.pyc
tests/openkal-work/

# mwrap consumer build/fetch artifacts
tests/mwrap/*/target/
tests/mwrap/*/.mcpp/
tests/mwrap/*/compile_commands.json
tests/mwrap/*/mcpp.lock
tests/mwrap/.indices/
